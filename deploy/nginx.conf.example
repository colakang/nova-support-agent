# nginx site for the demo (Cloudflare-proxied subdomain, CF origin certificate).
# Replace SITE_DOMAIN / paths, then: sudo nginx -t && sudo systemctl reload nginx
server {
    listen 80;
    server_name SITE_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name SITE_DOMAIN;

    ssl_certificate     /etc/nginx/ssl/cf_origin_cert.pem;
    ssl_certificate_key /etc/nginx/ssl/cf_private_key.pem;

    # Static Next.js export
    root /var/www/support-demo;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "microphone=(self)" always;

    location /_next/static/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }

    # API + SSE
    location /api/ {
        proxy_pass http://127.0.0.1:8095;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;          # stream step events as they happen
        proxy_cache off;
        proxy_read_timeout 300s;
        client_max_body_size 64k;
    }
}
