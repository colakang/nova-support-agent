#!/usr/bin/env sh
# Block commits that contain secrets. Enable with: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (https://github.com/gitleaks/gitleaks) — refusing to commit unscanned." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
