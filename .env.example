# Copy to .env and fill in. Never commit .env.

# --- OpenAI (chat orchestrator, embeddings, realtime voice) ---
OPENAI_API_KEY=sk-your-key-here
AGENT_MODEL=gpt-4.1-mini
JUDGE_MODEL=gpt-4.1-nano
EMBEDDING_MODEL=text-embedding-3-small
REALTIME_MODEL=gpt-realtime-mini
REALTIME_VOICE=marin
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Postgres + pgvector ---
DATABASE_URL=postgres://support:support@localhost:5433/support

# --- API server ---
PORT=8080
# Comma-separated origins allowed to call the API (dev: the Next.js dev server)
CORS_ORIGINS=http://localhost:3000

# --- Guardrails (calibrated by `pnpm calibrate`, see evals/README) ---
RETRIEVAL_TAU_HIGH=0.55
RETRIEVAL_TAU_LOW=0.40

# --- Production safety ---
# Hard daily spend cap across all sessions (USD). 0 disables.
DAILY_BUDGET_USD=10
# Per-IP token bucket: requests per minute for agent turns
RATE_LIMIT_TURNS_PER_MIN=12
# Per-IP realtime voice sessions per hour
RATE_LIMIT_VOICE_PER_HOUR=10
LLM_TIMEOUT_MS=20000

# --- Web (browser-visible) ---
# Leave empty in production (same origin behind Caddy). Dev: http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
