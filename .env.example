# Copy to .env (repo root) and fill in OPENAI_API_KEY. Never commit .env.
# Everything except OPENAI_API_KEY has a working default; values below are the ones the live demo uses.

# ─── Required ───────────────────────────────────────────────────────────────
# One OpenAI key powers the agent, embeddings, the grounding judge and realtime voice.
# Use a dedicated project key with a monthly spend limit set in the OpenAI dashboard.
OPENAI_API_KEY=sk-your-key-here

# Postgres + pgvector. `docker compose up -d db` gives you exactly this.
DATABASE_URL=postgres://support:support@localhost:5433/support

# ─── Models ─────────────────────────────────────────────────────────────────
AGENT_MODEL=gpt-6.1-terra            # orchestrator (Responses API, function calling)
AGENT_REASONING=low                  # none | minimal | low | medium
AGENT_SERVICE_TIER=default           # default | flex (half price, slower; evals use flex)
FALLBACK_MODEL=gpt-6-luna            # used after a timeout / 5xx on the primary
JUDGE_MODEL=gpt-6-luna               # grounding judge for grey-zone answers
EMBEDDING_MODEL=text-embedding-3-small
REALTIME_MODEL=gpt-realtime-2.1      # voice (gpt-realtime-2.1-mini is ~3x cheaper)
REALTIME_VOICE=marin
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
LLM_TIMEOUT_MS=20000

# ─── Guardrails (calibrated by `pnpm calibrate` → evals/results/calibration.md) ─
RETRIEVAL_TAU_LOW=0.50
RETRIEVAL_TAU_HIGH=0.63

# ─── API server ─────────────────────────────────────────────────────────────
PORT=8080
# Comma-separated browser origins allowed to call the API cross-origin (dev only;
# in production the web and API share one origin behind the reverse proxy).
CORS_ORIGINS=http://localhost:3000
# 1 = take the client IP from CF-Connecting-IP / X-Real-IP (only behind your own proxy).
TRUST_PROXY=0

# ─── Abuse & cost protection ───────────────────────────────────────────────
DAILY_BUDGET_USD=1.5                 # hard cap across all sessions per UTC day; 0 disables
SESSION_BUDGET_USD=0.4               # cap per conversation
RATE_LIMIT_TURNS_PER_MIN=12          # per IP
RATE_LIMIT_SESSIONS_PER_HOUR=20      # per IP
RATE_LIMIT_VOICE_PER_HOUR=30         # realtime sessions per IP
VOICE_MAX_SESSION_SECONDS=300        # the browser hangs up after this

# ─── Production (docker compose --profile prod) ─────────────────────────────
POSTGRES_PASSWORD=change-me          # compose builds DATABASE_URL for the api container from this
API_PORT=8095                        # host port the api binds on 127.0.0.1 (reverse proxy target)

# ─── Web (browser-visible, read at build time) ──────────────────────────────
# Unset in dev → http://localhost:8080. Production builds use "" (same origin behind the proxy).
# NEXT_PUBLIC_API_URL=

# ─── Tooling (optional) ─────────────────────────────────────────────────────
# LLM_CACHE_DIR=evals/.cache/llm     # disk cache of LLM responses (evals set this themselves)
# DATA_DIR=./data                    # corpus + fixtures location (the Docker image sets /app/data)
# API_URL=http://localhost:8080      # target for `pnpm chat`
